# Optional locally; Vercel origins are inferred automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required only for the explicit `pnpm content:sync` command.
NOTION_TOKEN=

# For uploading images to S3-compatible storage (e.g., Cloudflare R2).
# These are only required for `pnpm content:sync`. They are not used by the Next.js app.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=auto
# Public r2.dev or custom-domain origin; never the authenticated API endpoint.
S3_PUBLIC_URL=
