# Required only for the explicit `pnpm content:sync` command.
NOTION_TOKEN=

# Optional locally; Vercel origins are inferred automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For uploading images to S3-compatible storage (e.g., Cloudflare R2).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
S3_BUCKET_NAME=
