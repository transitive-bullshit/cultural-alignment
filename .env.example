# Optional override; Portless and Vercel origins are inferred automatically.
NEXT_PUBLIC_SITE_URL=

# Required by `pnpm content:sync` and `pnpm memes:upload-notion`.
NOTION_TOKEN=

# For uploading images to S3-compatible storage (e.g., Cloudflare R2).
# Required by normal/forced content sync; `--fast` and the Next.js app do not use them.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
S3_BUCKET_NAME=
# Optional bucket override for media descriptors. Defaults to S3_BUCKET_NAME.
S3_STATE_BUCKET_NAME=
S3_REGION=auto
# Public r2.dev or custom-domain origin; never the authenticated API endpoint.
S3_PUBLIC_URL=
