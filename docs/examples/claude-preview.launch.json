{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3017"
      ],
      "port": 3017
    },
    {
      "name": "next-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "next",
        "start",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3019"
      ],
      "port": 3019
    }
  ]
}
