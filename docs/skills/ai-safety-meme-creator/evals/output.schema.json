{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fixture_id",
    "recognition_hinge",
    "ai_bridges",
    "caption_lines",
    "format",
    "presentation",
    "why_it_works"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "recognition_hinge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "region_ids"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "region_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ai_bridges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept", "connection"],
        "properties": {
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "connection": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "caption_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "kind"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["canonical-quote", "intentional-rewrite", "original"]
          }
        }
      }
    },
    "format": {
      "type": "string",
      "enum": [
        "canon",
        "relabel",
        "collision",
        "dialogue",
        "state contrast",
        "source-native interface"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "frame_mode", "source_frames", "zones"],
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "overlay",
            "dialogue",
            "diptych",
            "interface",
            "band-top",
            "band-bottom",
            "sidecar-left",
            "sidecar-right"
          ]
        },
        "frame_mode": {
          "type": "string",
          "enum": ["cover", "contain", "extend"]
        },
        "source_frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image_id", "role"],
            "properties": {
              "image_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "single",
                  "before",
                  "after",
                  "left-speaker",
                  "right-speaker"
                ]
              }
            }
          }
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "line_indexes",
              "slot",
              "bounds_pct",
              "font_size_pct",
              "rendered_line_count",
              "style",
              "backdrop",
              "contrast",
              "palette",
              "anchor_region_id",
              "indent_levels"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "line_indexes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                }
              },
              "slot": {
                "type": "string",
                "enum": [
                  "top",
                  "bottom",
                  "top-left",
                  "top-right",
                  "bottom-left",
                  "bottom-right",
                  "panel-left",
                  "panel-right",
                  "full"
                ]
              },
              "bounds_pct": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "font_size_pct": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 20
              },
              "rendered_line_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "style": {
                "type": "string",
                "enum": ["impact", "dialogue", "code", "label", "status"]
              },
              "backdrop": {
                "type": "string",
                "enum": [
                  "none",
                  "edge-gradient",
                  "solid-panel",
                  "source-native"
                ]
              },
              "contrast": {
                "type": "string",
                "enum": [
                  "outlined",
                  "edge-gradient",
                  "solid-panel",
                  "source-native"
                ]
              },
              "palette": {
                "type": "string",
                "enum": ["default", "orange-white"]
              },
              "anchor_region_id": {
                "type": ["string", "null"]
              },
              "indent_levels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                }
              }
            }
          }
        }
      }
    },
    "why_it_works": {
      "type": "string",
      "minLength": 1
    }
  }
}
