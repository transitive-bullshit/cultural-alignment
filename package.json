{
  "name": "cultural-alignment",
  "version": "0.0.0",
  "private": true,
  "description": "Exploring real AI risks through the lens of pop culture",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "https://github.com/transitive-bullshit/cultural-alignment",
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build --webpack",
    "start": "next start",
    "content:sync": "node --import tsx scripts/sync.ts",
    "content:validate": "node --import tsx scripts/content-validate.ts",
    "content:audit": "node --import tsx scripts/content-audit.ts",
    "memes:upload-notion": "node --import tsx scripts/upload-finalized-memes-to-notion.ts",
    "memes:riff": "node --import tsx scripts/meme-riff.ts",
    "memes:review": "node --import tsx scripts/meme-candidate-review.ts",
    "review:visual": "node --import tsx scripts/visual-review.ts",
    "lint": "oxlint",
    "test": "run-s test:checks test:e2e",
    "test:checks": "run-s test:format test:lint test:types test:unit",
    "test:e2e": "portless run --name cultural-alignment-e2e playwright test",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:meme-skill": "vitest run --config vitest.meme-skill.config.ts docs/skills/ai-safety-meme-creator/evals",
    "test:types": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "typecheck": "pnpm test:types",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@notionhq/client": "^5.27.0",
    "@react-three/fiber": "^9.8.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "p-map": "^7.0.8",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "takumi-js": "^2.14.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@dotenvx/dotenvx": "^2.33.0",
    "@fisch0920/config": "^2.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "portless": "^0.15.7",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
