{
  "name": "cultural-alignment",
  "version": "0.0.0",
  "private": true,
  "description": "Exploring real AI risks through the lens of pop culture",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "https://github.com/transitive-bullshit/cultural-alignment",
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build --webpack",
    "start": "next start",
    "content:sync": "node --import tsx scripts/sync.ts",
    "content:validate": "node --import tsx scripts/content-validate.ts",
    "memes:assemble": "node --import tsx scripts/assemble-meme-review.ts",
    "memes:archive-round": "node --import tsx scripts/archive-meme-review-round.ts",
    "memes:prepare-batch": "node --import tsx scripts/prepare-meme-review-batch.ts",
    "memes:check-batch": "node --import tsx scripts/check-meme-review-batch.ts",
    "memes:prepare-round-02": "node --import tsx scripts/prepare-meme-review-round-02.ts",
    "memes:assemble-round-02": "node --import tsx scripts/assemble-meme-review-round-02.ts",
    "memes:check-layout-pass": "node --import tsx scripts/check-meme-review-layout-pass.ts",
    "memes:finalize-reverts": "node --import tsx scripts/finalize-reverted-meme-versions.ts",
    "memes:publish-parts": "node --import tsx scripts/publish-meme-review-parts.ts",
    "memes:contact-sheet": "node --import tsx scripts/render-meme-asset-contact-sheet.ts",
    "memes:preview-contact-sheet": "node --import tsx scripts/render-meme-preview-contact-sheet.ts",
    "memes:render-finalized": "node --import tsx scripts/render-finalized-meme-assets.ts",
    "memes:upload-notion": "node --import tsx scripts/upload-finalized-memes-to-notion.ts",
    "memes:snapshot-draft": "node --import tsx scripts/snapshot-meme-review-draft.ts",
    "lint": "oxlint",
    "test": "run-s test:checks test:e2e",
    "test:checks": "run-s test:format test:lint test:types test:unit",
    "test:e2e": "portless run --name cultural-alignment-e2e playwright test",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:meme-skill": "vitest run --config vitest.meme-skill.config.ts docs/skills/ai-safety-meme-creator/evals",
    "test:meme-skill:e2e": "playwright test --config playwright.artifacts.config.ts",
    "test:meme-skill:live": "MEME_SKILL_EVALS=1 vitest run --config vitest.meme-skill.config.ts docs/skills/ai-safety-meme-creator/evals/archive-ab/v3.integration.test.ts --no-file-parallelism --maxWorkers 1",
    "memes:skill-ab": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/runner.ts",
    "memes:skill-ab:report": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/report.ts",
    "memes:skill-v3": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/v3-runner.ts",
    "memes:skill-v3:recompose": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/recompose-v3-manifest.ts",
    "memes:skill-v3:merge-repair": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/merge-v3-manifests.ts",
    "memes:skill-v3:recover-report": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/recover-report.ts",
    "memes:skill-v4-impact": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/create-impact-batch.ts",
    "memes:skill-v4-impact:report": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/impact-comparison-report.ts test-results/meme-skill-archive-v4-impact/baseline-v3-manifest.json test-results/meme-skill-archive-v4-impact/run-manifest.json",
    "memes:skill-v5-stroke-wrap": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/create-stroke-wrap-batch.ts",
    "memes:skill-v5-stroke-wrap:report": "node --import tsx docs/skills/ai-safety-meme-creator/evals/archive-ab/stroke-wrap-comparison-report.ts test-results/meme-skill-archive-v5-stroke-wrap/baseline-v4-manifest.json test-results/meme-skill-archive-v5-stroke-wrap/run-manifest.json",
    "test:types": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "typecheck": "pnpm test:types",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@notionhq/client": "^5.26.0",
    "@react-three/fiber": "^9.8.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "p-map": "^7.0.8",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "takumi-js": "^2.14.0",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@dotenvx/dotenvx": "^2.30.0",
    "@fisch0920/config": "^2.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "portless": "^0.15.6",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
